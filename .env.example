# ---------------------------------------------------------------------------
# Copy to .env in this directory and fill in. Never commit the real file.
#
# Rule: no trailing "# comment" on a value line — python-dotenv keeps it as
# part of the value, which breaks LLM_PROVIDER, ENVIRONMENT and friends.
# ---------------------------------------------------------------------------

# --- WhatsApp Cloud API ---
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
# Any random string you invent; Meta must be given the same one.
WA_VERIFY_TOKEN=
# Meta app secret, used to verify X-Hub-Signature-256.
WA_APP_SECRET=
WA_API_VERSION=v26.0

# --- Supabase ---
# Project origin only, e.g. https://abcdefg.supabase.co — not the REST URL.
SUPABASE_URL=
# Current key names. The secret key is backend-only and bypasses RLS.
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
# Verifies dashboard tokens locally against the project's published keys.
SUPABASE_JWKS_URL=
# Legacy equivalents, still accepted if the new keys are not enabled.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# --- LLM ---
# openrouter | gemini | openai | anthropic
LLM_PROVIDER=openrouter

# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://kfoods.lk
OPENROUTER_APP_NAME=K FOOD WhatsApp Agent

# Routed model id. It MUST support tool calling, or the agent cannot look up
# prices. Checked live on OpenRouter (per 1M tokens, in/out):
#   google/gemini-3.1-flash-lite   $0.25 / $1.50   <- default
#   google/gemini-2.5-flash-lite   $0.10 / $0.40   cheapest sensible option
#   openai/gpt-4o-mini             $0.15 / $0.60
#   google/gemini-2.5-flash        $0.30 / $2.50   strongest of these
LLM_MODEL=google/gemini-3.1-flash-lite

# Only needed if LLM_PROVIDER is switched away from openrouter.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

LLM_TEMPERATURE=0.2
LLM_MAX_TOOL_LOOPS=6

# --- App ---
# uuid of the businesses row, printed by supabase/seed.sql
BUSINESS_ID=
AUTO_RETURN_MINUTES=30
HISTORY_TURNS=10
NOTES_LIMIT=5
LOG_LEVEL=INFO
# development | production
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
SEND_RATE_LIMIT_PER_MINUTE=30
# Set false only for local smoke tests.
REQUIRE_AUTH=true
