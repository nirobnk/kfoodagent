# ---------------------------------------------------------------------------
# Copy to .env in this directory and fill in. Never commit the real file.
#
# Rule: no trailing "# comment" on a value line — python-dotenv keeps it as
# part of the value, which breaks LLM_PROVIDER, ENVIRONMENT and friends.
# ---------------------------------------------------------------------------

# --- WhatsApp Cloud API ---
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
# Any random string you invent; Meta must be given the same one.
WA_VERIFY_TOKEN=
# Meta app secret, used to verify X-Hub-Signature-256.
WA_APP_SECRET=
WA_API_VERSION=v26.0

# --- Supabase ---
# Project origin only, e.g. https://abcdefg.supabase.co — not the REST URL.
SUPABASE_URL=
# Current key names. The secret key is backend-only and bypasses RLS.
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
# Verifies dashboard tokens locally against the project's published keys.
SUPABASE_JWKS_URL=
# Legacy equivalents, still accepted if the new keys are not enabled.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# --- LLM ---
# openrouter | gemini | openai | anthropic
LLM_PROVIDER=openrouter

# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://kfoods.lk
OPENROUTER_APP_NAME=K FOOD WhatsApp Agent

# Optional. Leave BLANK to use the default model for LLM_PROVIDER, so
# switching provider is a one-line change. Set it only to pin a specific model.
#
#   openrouter   google/gemini-2.5-flash      (vendor/model prefix required)
#   openai       gpt-4o-mini                  (no prefix)
#   gemini       gemini-2.0-flash
#   anthropic    claude-haiku-4-5-20251001    needs langchain-anthropic
#
# Whatever you pick MUST support tool calling, or the agent cannot look up
# prices. A prefixed id sent to a vendor's own API is rejected with a 404, so
# startup warns if LLM_MODEL does not match the provider.
LLM_MODEL=

# Only the key for the provider named above is required.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Voice-note transcription always uses OpenAI's audio transcription API,
# regardless of which provider powers the conversational agent. Without an
# OpenAI key, voice notes safely fall back to asking the customer to type.
VOICE_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Reject unexpectedly large media before holding it in memory (10 MiB).
VOICE_MAX_BYTES=10485760
# Hard ceiling; configuration validation does not allow more than two minutes.
VOICE_MAX_DURATION_SECONDS=120
VOICE_TRANSCRIPTION_TIMEOUT_SECONDS=30

# Receipt images/PDFs are copied from Meta into a private Supabase bucket.
RECEIPT_MAX_BYTES=10485760

# Reasoning models only (gpt-5*, o-series). Older chat models reject it, so
# leave it blank for gpt-4o and friends. Valid values vary by model.
#
# IMPORTANT: this agent always calls tools, and gpt-5.6-* refuses tool calls on
# /v1/chat/completions with any value other than "none" — which would fail every
# customer reply. Startup warns if it is set to anything else.
LLM_REASONING_EFFORT=

LLM_TEMPERATURE=0.2
LLM_MAX_TOOL_LOOPS=6

# Ceiling on one reply. Leave it generous but never unset: providers reserve
# credit against the model's full output ceiling (65k on Gemini Flash), so an
# uncapped request is rejected with a 402 on a low balance before it runs.
LLM_MAX_TOKENS=1024

# --- Tunnel (local development only) ---
# Read by the ngrok CLI, not by this application. `make tunnel` exposes the
# local backend so Meta can reach the webhook; `make webhook` then registers
# the URL. Claim a free static domain and set NGROK_DOMAIN so the URL, and so
# the Meta callback, stop changing on every restart.
# https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# --- App ---
# uuid of the businesses row, printed by supabase/seed.sql
BUSINESS_ID=
AUTO_RETURN_MINUTES=30
HISTORY_TURNS=10
NOTES_LIMIT=5
LOG_LEVEL=INFO
# development | production
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
SEND_RATE_LIMIT_PER_MINUTE=30
# Set false only for local smoke tests.
REQUIRE_AUTH=true
